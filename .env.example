# ===== Google Sheets (Service Account) =====
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/[THIS_PART]/edit
GOOGLE_SPREADSHEET_ID=

# Service Account credentials (obtidas do JSON baixado no Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ===== Login com Google (OAuth 2.0) =====
# Frontend (Vite): exposto ao navegador — pode usar o Client ID publicamente.
VITE_GOOGLE_CLIENT_ID=

# Backend (Node/Express): NUNCA expor o Client Secret no front-end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=